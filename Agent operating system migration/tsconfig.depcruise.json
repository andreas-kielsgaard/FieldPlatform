{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": "apps/web",
    "ignoreDeprecations": "6.0",
    "paths": {
      "~/*": ["src/*", "app/*"]
    }
  },
  "include": ["apps/web/app/**/*", "apps/web/src/**/*"]
}
