{
  "schemaVersion": "0.1.0",
  "adapterId": "field-platform",
  "repoId": "field-platform",
  "displayName": "Field Platform",
  "repoRoot": ".",
  "pathFormat": "repo-relative-posix",
  "sourceGroups": [
    {
      "id": "active-web-source",
      "root": "apps/web",
      "include": ["app/**/*", "src/**/*"],
      "exclude": [".react-router/**/*", "build/**/*"],
      "documentKinds": ["source", "test", "config", "schema"]
    },
    {
      "id": "agent-tools-source",
      "root": "tools/agent-tools",
      "include": ["src/**/*", "test/**/*"],
      "exclude": [],
      "documentKinds": ["source", "test", "schema"]
    },
    {
      "id": "project-config",
      "root": ".",
      "include": [
        "package.json",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml",
        "biome.json",
        "tsconfig*.json",
        "dependency-cruiser.config.cjs",
        "apps/web/package.json",
        "apps/web/tsconfig.json",
        "apps/web/*config.ts",
        "tools/agent-tools/package.json"
      ],
      "exclude": [],
      "documentKinds": ["config"]
    },
    {
      "id": "project-guidance",
      "root": ".",
      "include": [
        "README.md",
        "AGENTS.md",
        "Agent OS/*.md",
        "Agent OS/prompt-files/agent-attention-system/**/*.md",
        "Agent OS/project-control-files/**/*.md"
      ],
      "exclude": [],
      "documentKinds": ["documentation"]
    },
    {
      "id": "generated-output",
      "root": ".",
      "include": [
        "apps/web/.react-router/**/*",
        "apps/web/build/**/*",
        "apps/web/storybook-static/**/*",
        "apps/web/playwright-report/**/*",
        "apps/web/test-results/**/*",
        "coverage/**/*"
      ],
      "exclude": [
        "apps/web/.react-router/**/*",
        "apps/web/build/**/*",
        "apps/web/storybook-static/**/*",
        "apps/web/playwright-report/**/*",
        "apps/web/test-results/**/*",
        "coverage/**/*"
      ],
      "documentKinds": ["generated"]
    },
    {
      "id": "archive",
      "root": ".",
      "include": ["Archive/**/*"],
      "exclude": ["Archive/**/*"],
      "documentKinds": ["archive"]
    }
  ],
  "capabilities": {
    "implemented": [
      "context-cli-help",
      "schema-registry-inspection",
      "command-envelope-contract",
      "adapter-config-contract",
      "manifest-generation",
      "symbol-extraction",
      "dependency-evidence",
      "evidence-snapshot",
      "file-focused-evidence-inspection",
      "exact-symbol-lookup",
      "lexical-search"
    ],
    "unimplemented": ["source-indexing", "embeddings-or-vector-search", "agent-os-prompt-weaving"]
  }
}
